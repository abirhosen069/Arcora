NODE_ENV=development
PORT=8080
DATABASE_URL=postgresql://arcora:arcora@localhost:5432/arcora
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace_with_strong_secret
JWT_EXPIRES_IN=7d

# CORS
# Comma-separated origins for production, e.g. https://api.arcora.app,https://app.arcora.app
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Arc Testnet / wallet provider configuration
ARC_NETWORK_NAME=Arc Testnet
ARC_CHAIN_ID=5042002
ARC_RPC_URL=https://rpc.testnet.arc.network
ARC_EXPLORER_URL=https://testnet.arcscan.app
ARC_USDC_ADDRESS=0x3600000000000000000000000000000000000000
ARC_GAS_TRACKER_URL=https://testnet.arcscan.app/gas-tracker
ARC_FAUCET_URL=https://faucet.circle.com
ARC_PAYMASTER_URL=replace_with_paymaster_or_bundler_url_if_used

# Circle/App Kit or selected wallet infrastructure provider
CIRCLE_KIT_KEY=replace_with_circle_app_kit_or_client_key
CIRCLE_API_KEY=replace_with_circle_backend_api_key_if_backend_calls_are_used
CIRCLE_PROJECT_ID=replace_with_circle_project_or_app_id
CIRCLE_WALLET_SET_ID=replace_with_circle_wallet_set_id
TRANSACTION_EXECUTION_MODE=server_relay

# Server relay wallet for Arc Testnet USDC broadcast (never commit a funded production key)
RELAYER_PRIVATE_KEY=replace_with_testnet_relayer_private_key

# Google/Auth provider credentials
GOOGLE_ANDROID_CLIENT_ID=replace_with_google_android_client_id
GOOGLE_WEB_CLIENT_ID=replace_with_google_web_client_id

# Optional observability
SENTRY_DSN=
